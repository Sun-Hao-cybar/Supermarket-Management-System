<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supermarket.backend.mapper.PurchaseDetailMapper">
    <resultMap id="BaseResultMap" type="com.supermarket.backend.entity.PurchaseDetail">
        <id column="id" property="id"/>
        <result column="detail_no" property="detailNo"/>
        <result column="purchase_no" property="purchaseNo"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_num" property="goodsNum"/>
        <result column="goods_price" property="goodsPrice"/>
        <result column="total_price" property="totalPrice"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        select * from purchase_detail
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into purchase_detail(detail_no,purchase_no,goods_id,goods_num,goods_price,total_price,remark)
        values(#{detailNo},#{purchaseNo},#{goodsId},#{goodsNum},#{goodsPrice},#{totalPrice},#{remark})
    </insert>

    <update id="update">
        update purchase_detail
        set detail_no=#{detailNo},purchase_no=#{purchaseNo},goods_id=#{goodsId},
        goods_num=#{goodsNum},goods_price=#{goodsPrice},total_price=#{totalPrice},remark=#{remark}
        where id=#{id}
    </update>

    <delete id="deleteById">
        delete from purchase_detail where id=#{id}
    </delete>
</mapper>